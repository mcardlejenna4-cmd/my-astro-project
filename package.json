{
  "name": "my-astro-blog",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:bdd": "cucumber-js --import 'tsx' --import 'features/step_definitions/**/*.ts' --import 'features/support/**/*.ts'",
    "server:preview": "cross-env HOST=127.0.0.1 PORT=4321 node ./dist/server/entry.mjs",
    "test:bdd:ci": "start-server-and-test server:preview http://127.0.0.1:4321/api/health test:bdd"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "playwright": "^1.64.1",
    "start-server-and-test": "^3.0.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  }
}
